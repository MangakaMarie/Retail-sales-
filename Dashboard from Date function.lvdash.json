{
  "datasets": [
    {
      "name": "8035c1ea",
      "displayName": "Retail Sales Summary by Date and Product Category",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    COUNT(DISTINCT `Customer ID`) AS unique_customer,\n",
        "    Date,\n",
        "    YEAR(Date) AS trans_year,\n",
        "    MONTH(Date) AS trans_month,\n",
        "    MONTHNAME(Date) AS trans_month_name,\n",
        "    DAY(Date) AS trans_day,\n",
        "    DAYNAME(Date) AS trans_day_name,\n",
        "    SUM(`Total Amount`) AS revenue,\n",
        "    `Product Category`\n",
        "FROM database.retail.retail_sales_dataset\n",
        "GROUP BY ALL;"
      ]
    }
  ],
